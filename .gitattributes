<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CivicShield | Civic Issue Reporter</title>
<style>
:root {
  --green:#176b4a; --dark:#123d2c; --bg:#f4f7f5;
  --muted:#68776f; --line:#e0e8e2; --white:#fff;
}
* { box-sizing:border-box; }
body {
  margin:0; font-family:Arial,sans-serif;
  color:#20352a; background:var(--bg);
}
header {
  background:var(--dark); color:white;
  padding:18px 6%; display:flex;
  justify-content:space-between; align-items:center;
  flex-wrap:wrap; gap:14px;
}
.brand { font-size:23px; font-weight:bold; }
.brand span { color:#9fe0b9; }
nav { display:flex; gap:18px; flex-wrap:wrap; }
nav a { color:white; text-decoration:none; font-size:14px; }
button {
  cursor:pointer; border:0; border-radius:9px;
  padding:12px 16px; font-weight:bold;
}
.primary { background:var(--green); color:white; }
.secondary { background:#e4f2e9; color:var(--green); }
main { max-width:1120px; margin:auto; padding:30px 20px; }
.hero {
  background:linear-gradient(120deg,#123d2c,#237952);
  color:white; padding:36px; border-radius:18px;
}
.hero h1 { font-size:clamp(30px,5vw,46px); margin:12px 0; }
.hero p { color:#d9eee2; max-width:650px; line-height:1.7; }
.eyebrow { font-size:12px; letter-spacing:2px; font-weight:bold; }
.stats {
  display:grid; grid-template-columns:repeat(4,1fr);
  gap:14px; margin:22px 0;
}
.stat,.panel,.issue {
  background:white; border:1px solid var(--line);
  border-radius:13px; padding:19px;
}
.stat strong { display:block; font-size:27px; margin:8px 0; }
.muted { color:var(--muted); font-size:13px; }
.layout {
  display:grid; grid-template-columns:1fr 1.2fr;
  gap:20px; align-items:start;
}
h2 { font-size:21px; margin-top:0; }
label { display:block; font-size:13px; font-weight:bold; margin:15px 0 7px; }
input,select,textarea {
  width:100%; padding:12px; border:1px solid #d5e0d8;
  border-radius:8px; font:inherit; background:white;
}
textarea { resize:vertical; min-height:85px; }
.full { width:100%; margin-top:17px; }
.issue { margin-top:12px; padding:16px; }
.issue-top { display:flex; justify-content:space-between; gap:10px; }
.issue h3 { font-size:16px; margin:10px 0; }
.tag {
  display:inline-block; border-radius:20px;
  padding:6px 9px; font-size:11px; font-weight:bold;
  background:#edf2ef; color:#456052;
}
.tag.high { background:#ffe9e5; color:#ad392a; }
.tag.done { background:#dff4e6; color:#176b4a; }
.issue p { font-size:13px; line-height:1.5; color:var(--muted); }
.filters { display:flex; gap:8px; margin:15px 0; }
.filters select { flex:1; min-width:0; }
#notice { margin-top:12px; color:var(--green); font-size:13px; }
footer { text-align:center; padding:25px; color:var(--muted); font-size:12px; }
@media(max-width:760px) {
  .stats { grid-template-columns:repeat(2,1fr); }
  .layout { grid-template-columns:1fr; }
  .hero { padding:25px; }
}
</style>
</head>
<body>
<header>
  <div class="brand">🛡️ Civic<span>Shield</span></div>
  <nav>
    <a href="#home">Home</a>
    <a href="#report">Report Issue</a>
    <a href="#issues">Issue Dashboard</a>
    <a href="#track">Track Complaint</a>
  </nav>
</header>

<main>
<section class="hero" id="home">
  <div class="eyebrow">SMARTER COMMUNITIES · SAFER STREETS</div>
  <h1>Your city. Your voice.<br>Let's make it safer.</h1>
  <p>Report potholes, damaged roads, garbage, broken streetlights,
  and water leaks. Follow reported issues and help bring attention
  to problems in your community.</p>
  <button class="secondary" onclick="document.querySelector('#report').scrollIntoView({behavior:'smooth'})">
    + Report a civic issue
  </button>
</section>

<section class="stats">
  <div class="stat"><span class="muted">Total reports</span><strong id="total">3</strong><span class="muted">Submitted issues</span></div>
  <div class="stat"><span class="muted">Open issues</span><strong id="open">2</strong><span class="muted">Awaiting resolution</span></div>
  <div class="stat"><span class="muted">Resolved</span><strong id="resolved">1</strong><span class="muted">Marked resolved</span></div>
  <div class="stat"><span class="muted">Issue categories</span><strong>4+</strong><span class="muted">Types supported</span></div>
</section>

<div class="layout">
<section class="panel" id="report">
  <h2>📝 Report an issue</h2>
  <p class="muted">Provide accurate details to help identify the problem.</p>
  <form id="reportForm">
    <label for="type">Issue category</label>
    <select id="type" required>
      <option value="Pothole">Pothole / damaged road</option>
      <option value="Garbage">Garbage accumulation</option>
      <option value="Streetlight">Broken streetlight</option>
      <option value="Water leakage">Water leakage</option>
      <option value="Other">Other civic issue</option>
    </select>
    <label for="location">Location / landmark</label>
    <input id="location" placeholder="e.g. Near bus stop, Main Road" required>
    <label for="description">Description</label>
    <textarea id="description" placeholder="Describe the issue and any safety risks..." required></textarea>
    <label for="severity">Severity</label>
    <select id="severity">
      <option>Medium</option><option>High</option><option>Low</option>
    </select>
    <label for="photo">Photo (optional)</label>
    <input id="photo" type="file" accept="image/*">
    <button class="primary full" type="submit">Submit report →</button>
    <div id="notice" role="status"></div>
  </form>
</section>

<section id="issues">
  <div class="panel">
    <h2>📍 Civic issue dashboard</h2>
    <p class="muted">Explore sample reports and the issues submitted here.</p>
    <div class="filters">
      <select id="filterType" aria-label="Filter category">
        <option value="">All categories</option>
        <option>Pothole</option><option>Garbage</option>
        <option>Streetlight</option><option>Water leakage</option>
        <option>Other</option>
      </select>
      <select id="filterStatus" aria-label="Filter status">
        <option value="">All statuses</option>
        <option>Reported</option><option>In Progress</option>
        <option>Resolved</option>
      </select>
    </div>
    <div id="issueList"></div>
  </div>

  <div class="panel" id="track" style="margin-top:18px">
    <h2>🔎 Track a complaint</h2>
    <p class="muted">Enter the complaint ID shown after submission.</p>
    <label for="trackId">Complaint ID</label>
    <input id="trackId" placeholder="e.g. CIV-1001">
    <button class="primary full" onclick="trackComplaint()">Track status</button>
    <div id="trackResult" aria-live="polite"></div>
  </div>
</section>
</div>
</main>

<footer>
  CivicShield Mini Project · Civic awareness and public safety<br>
  Demo only — sample reports do not represent verified live complaints.
</footer>

<script>
const samples = [
 {id:"CIV-1001",type:"Pothole",location:"Main Road, Sector 2",
  description:"Large pothole creating a potential hazard for two-wheelers.",
  severity:"High",status:"Reported"},
 {id:"CIV-1002",type:"Garbage",location:"Community Park entrance",
  description:"Waste has accumulated near the public walkway.",
  severity:"Medium",status:"In Progress"},
 {id:"CIV-1003",type:"Streetlight",location:"Market Street",
  description:"Streetlight not functioning at night.",
  severity:"Medium",status:"Resolved"}
];

let reports;
try {
  reports = JSON.parse(localStorage.getItem("civicShieldReports")) || samples;
} catch {
  reports = samples;
}

function save() {
  try {
    localStorage.setItem("civicShieldReports", JSON.stringify(reports));
  } catch {}
}

function render() {
  const type = document.getElementById("filterType").value;
  const status = document.getElementById("filterStatus").value;
  const visible = reports.filter(r =>
    (!type || r.type === type) && (!status || r.status === status)
  );

  document.getElementById("total").textContent = reports.length;
  document.getElementById("open").textContent =
    reports.filter(r => r.status !== "Resolved").length;
  document.getElementById("resolved").textContent =
    reports.filter(r => r.status === "Resolved").length;

  const list = document.getElementById("issueList");
  list.replaceChildren();

  if (!visible.length) {
    list.textContent = "No issues match these filters.";
    return;
  }

  visible.slice().reverse().forEach(r => {
    const card = document.createElement("article");
    card.className = "issue";

    const top = document.createElement("div");
    top.className = "issue-top";
    const category = document.createElement("span");
    category.className = "tag";
    category.textContent = r.type;
    const state = document.createElement("span");
    state.className = "tag " + (r.status === "Resolved" ? "done" : "");
    state.textContent = r.status;
    top.append(category, state);

    const title = document.createElement("h3");
    title.textContent = r.location;
    const desc = document.createElement("p");
    desc.textContent = r.description;
    const meta = document.createElement("p");
    meta.textContent = r.id + " · " + r.severity + " priority";

    card.append(top, title, desc, meta);
    list.append(card);
  });
}

document.getElementById("reportForm").addEventListener("submit", e => {
  e.preventDefault();

  const file = document.getElementById("photo").files[0];
  const report = {
    id:"CIV-" + (1001 + Date.now() % 8999),
    type:document.getElementById("type").value,
    location:document.getElementById("location").value.trim(),
    description:document.getElementById("description").value.trim(),
    severity:document.getElementById("severity").value,
    status:"Reported"
  };

  if (!report.location || !report.description) return;

  reports.push(report);
  save();
  render();

  document.getElementById("notice").textContent =
    "Demo report submitted! Your complaint ID is " + report.id +
    (file ? ". Note: the selected photo is not uploaded." : ".");
  document.getElementById("reportForm").reset();
  document.getElementById("trackId").value = report.id;
});

function trackComplaint() {
  const id = document.getElementById("trackId").value.trim().toUpperCase();
  const result = document.getElementById("trackResult");
  const report = reports.find(r => r.id.toUpperCase() === id);
  result.replaceChildren();

  const message = document.createElement("p");
  message.style.marginTop = "14px";
  message.textContent = report
    ? report.id + ": " + report.status + " — " + report.location
    : "Complaint not found. Check the ID and try again.";
  result.append(message);
}

document.getElementById("filterType").addEventListener("change", render);
document.getElementById("filterStatus").addEventListener("change", render);
render();
</script>
</body>
</html>